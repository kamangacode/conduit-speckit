# PostgreSQL container settings
POSTGRES_DB=conduit-speckit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Spring Boot local connection settings
DATABASE_URL=jdbc:postgresql://localhost:5432/conduit-speckit
DATABASE_USERNAME=conduit
DATABASE_PASSWORD=replace-with-a-local-secret

# Required application secret
JWT_SECRET=replace-with-at-least-32-random-characters
